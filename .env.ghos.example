# Browser-visible managed Supabase configuration.
# Do not put a service-role key or database password in this file.
VITE_SUPABASE_PROJECT_ID=caegybyfdkmgjrygnavg
VITE_SUPABASE_URL=https://caegybyfdkmgjrygnavg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_EXISTING_PUBLISHABLE_KEY
VITE_PUBLIC_WEB_URL=https://winterwatch-pro.info

# Optional Dispatch driver integration. These values are browser-visible.
VITE_DISPATCH_DRIVER_ROUTE_URL=https://contractor.ghstickets.com/dispatch/driver
VITE_DISPATCH_DRIVER_LOCATION_ENDPOINT=https://contractor.ghstickets.com/api/dispatch-driver-location
VITE_DISPATCH_DRIVER_TRACKING_TOKEN=REPLACE_WITH_BROWSER_TRACKING_TOKEN

# Deployment-only guard. This is not exposed to the browser.
WINTERWATCH_EXPECTED_SUPABASE_PROJECT_ID=caegybyfdkmgjrygnavg

# Host publication settings used by compose.ghos.yml.
WINTERWATCH_BIND_ADDRESS=0.0.0.0
WINTERWATCH_HTTP_PORT=8083
WINTERWATCH_IMAGE=ghos/winterwatch-pro:managed-supabase
